{
  "name": "dirt-routing-workspace",
  "private": true,
  "scripts": {
    "test": "node --test --test-concurrency=1 scripts/pack-fabric/bench/*.test.js scripts/pack-fabric/poi/*.test.js scripts/pack-fabric/routing/**/*.test.js scripts/pack-fabric/routing/lib/adventure/*.test.js scripts/pack-fabric/scripts/*.test.js",
    "bench:from-here": "node scripts/pack-fabric/bench/run-from-here-probe.js",
    "bench:from-here-matrix": "node scripts/pack-fabric/bench/run-from-here-matrix.js",
    "bench:rebuild-matrix": "node scripts/pack-fabric/bench/run-rebuild-matrix.js",
    "test:adventure": "node --test scripts/pack-fabric/routing/lib/adventure/*.test.js",
    "bench:rebuild": "node scripts/pack-fabric/bench/run-rebuild-baseline.js",
    "bench:resource-probe": "node scripts/pack-fabric/bench/run-resource-probe.js",
    "bench:projected-probe": "node scripts/pack-fabric/bench/run-projected-probe.js",
    "bench:ns": "node scripts/pack-fabric/bench/run-ns-bench.js",
    "bench:fuel-regressions": "node scripts/pack-fabric/bench/run-fuel-regressions.js",
    "bench:routing-oracle": "node scripts/pack-fabric/bench/run-routing-oracle.js",
    "test:phase": "npm test && npm run bench:ns"
  }
}
