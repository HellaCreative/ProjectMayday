{
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/route.js": {
      "memory": 2048,
      "maxDuration": 300,
      "includeFiles": "routing/{lib,regional,schema}/**"
    },
    "api/fuel.js": {
      "memory": 1024,
      "maxDuration": 30,
      "includeFiles": "routing/{lib,regional,schema}/**"
    },
    "api/fuel-chain.js": {
      "memory": 2048,
      "maxDuration": 60,
      "includeFiles": "routing/{lib,regional,schema}/**"
    },
    "api/poi.js": {
      "memory": 1024,
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ]
}
