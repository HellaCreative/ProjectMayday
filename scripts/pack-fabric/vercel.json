{
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/route.js": {
      "memory": 2048,
      "maxDuration": 300,
      "includeFiles": "routing/{lib,regional,schema}/**",
      "excludeFiles": "{app/data,routing/data,routing/candidates}/**"
    },
    "api/fuel.js": {
      "memory": 1024,
      "maxDuration": 30,
      "includeFiles": "routing/{lib,regional,schema}/**",
      "excludeFiles": "{app/data,routing/data,routing/candidates}/**"
    },
    "api/fuel-chain.js": {
      "memory": 2048,
      "maxDuration": 105,
      "includeFiles": "routing/{lib,regional,schema}/**",
      "excludeFiles": "{app/data,routing/data,routing/candidates}/**"
    },
    "api/poi.js": {
      "memory": 1024,
      "maxDuration": 30,
      "includeFiles": "poi/**"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ]
}
