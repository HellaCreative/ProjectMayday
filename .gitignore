scripts/pack-fabric/app/data/packs/**/*.bin
scripts/pack-fabric/app/data/packs/**/fuel.v1.json
*.mbtiles

# Local GIS extracts and graph.v1 intermediates
scripts/pack-fabric/data-raw/
scripts/pack-fabric/routing/data/regions/**
