scripts/pack-fabric/routing/data/reports/**
scripts/pack-fabric/routing/candidates/

# BC OSM feasibility binaries
experiments/bc-osm-only/out/
experiments/bc-osm-only/*.log
Dirt/Resources/BC.mbtiles

# OSM fuel extract + packed chunks
data-raw/

# Generated Rider Services region files are published to R2, not Git/Vercel.
scripts/pack-fabric/app/data/rider-services/

# Local deploy caches — account ids, not source
scripts/pack-fabric/.vercel/
scripts/pack-fabric/.wrangler/
scripts/pack-fabric/.env*

# Shortbread edge service dependencies and generated tile archives
scripts/shortbread-edge/node_modules/
scripts/shortbread-edge/.wrangler/
scripts/shortbread-edge/artifacts/
