+    /// Reuses one current predecessor chain across outgoing-edge checks. Every
+    /// predecessor write must invalidate this index if it touches that chain.
+    /// The indexed overlap predicate is exactly Span.overlaps; no road is added
+    /// or removed and no distance/cost threshold changes.
+    final class HistoryIndex {
+        private var start: Int?
+        private var ancestors = Set<Int>()
+        private var byEdge: [Int: [Span]] = [:]
+        private var cyclic = false
+
+        func predecessorChanged(_ node: Int) {
+            if ancestors.contains(node) { start = nil }
+        }
+
+        func contains(node initial: Int, span: Span,
+                      previous: (Int) -> Int, record: (Int) -> Span?) -> Bool {
+            if start != initial {
+                ancestors.removeAll(keepingCapacity: true)
+                byEdge.removeAll(keepingCapacity: true)
+                cyclic = false
+                var node = initial, steps = 0
+                while node >= 0 {
+                    guard ancestors.insert(node).inserted else {
+                        cyclic = true
+                        break
+                    }
+                    if let row = record(node) { byEdge[row.edge, default: []].append(row) }
+                    let next = previous(node)
+                    steps += 1
+                    if next == node || steps > 10_000_000 {
+                        cyclic = true
+                        break
+                    }
+                    node = next
+                }
+                start = initial
+            }
+            return cyclic || (byEdge[span.edge] ?? []).contains { $0.overlaps(span) }
+        }
+    }
